{
  "manifest_version": 3,
  "name": "BBB Class Recorder",
  "version": "2.0.0",
  "description": "Click the icon to record the current tab (video + sound), or download the saved séance you are watching. Click again to stop and save.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "scripting", "activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/mod/bigbluebuttonbn/*"],
      "js": ["moodle-buttons.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/playback/presentation/*"],
      "js": ["playback-download.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["merge.js", "vendor/mediabunny.min.mjs"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Start recording this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
